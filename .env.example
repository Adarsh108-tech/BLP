# Required Environment Variables for Vercel / Production Deployment

# 1. MongoDB Atlas Connection URI (points strictly to bookleaf_portal database)
MONGOURI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/bookleaf_portal?retryWrites=true&w=majority

# 2. Google Gemini API Key (gemini-3.5-flash / gemini-3.8-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. JWT Session Encryption Secret
NEXTAUTH_SECRET=your_super_secret_jwt_key_here
JWT_SECRET=your_super_secret_jwt_key_here
